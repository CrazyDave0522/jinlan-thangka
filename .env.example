# Copy to .env.local; add the same variables to Vercel before deploying.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key only.
# Never use a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Grounded-answer integration: server-only settings. Never prefix with NEXT_PUBLIC_.
# Put the real key in ignored .env.local, not in this example or chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Keep paid calls disabled until funded live testing is explicitly approved.
DEEPSEEK_ENABLED=false
